{
  "name": "guised-up/laravel-api",
  "description": "Laravel API for the Guised Up take-home assessment",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "laravel/sanctum": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    ,
    "Database\\Seeders\\": "database/seeders/"
    }
  },
  "config": {
    "policy": {
      "advisories": {
        "block": false
      }
    }
  }
}
